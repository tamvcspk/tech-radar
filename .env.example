# Copy file này thành .env rồi điền giá trị thật. Không commit .env.

# Gemini API (AI Studio): https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Telegram bot (lấy từ @BotFather)
TELEGRAM_BOT_TOKEN=

# Chat ID nhận tin (ví dụ: id cá nhân hoặc id kênh)
TELEGRAM_CHAT_ID=

# Bật để chỉ in tin ra console thay vì gửi Telegram (1 = bật)
DRY_RUN=1
